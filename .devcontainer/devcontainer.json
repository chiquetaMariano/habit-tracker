{
  "name": "Expo React Native",
  "image": "node:20-alpine",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8081, 19000, 19001, 19002],
  "portsAttributes": {
    "8081": {
      "label": "Metro Bundler"
    },
    "19000": {
      "label": "Expo"
    },
    "19001": {
      "label": "Expo"
    },
    "19002": {
      "label": "Expo DevTools"
    }
  },
  "postCreateCommand": "npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}